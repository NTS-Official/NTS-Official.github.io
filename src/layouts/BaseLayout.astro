---
// 站点壳：header / nav / footer 的唯一来源。
// 以前这些在 11 个 HTML 里各抄一遍，nav 的相对路径还抄错了好几处。
const { title, description = 'NoTuring_Steve in Team Astralisium' } = Astro.props;

const nav = [
  { href: '/index.html', label: '首页' },
  { href: '/blog/index.html', label: '文章' },
  { href: '/projects/neolectrum', label: '项目' },
  { href: '/about/index.html', label: '关于' },
  { href: '/#side-bar', label: '外部' },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <!-- 明确告知浏览器本站只有浅色主题，避免深色模式下被自动变暗/反色 -->
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#f8fafc">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="icon" href="/assets/pictures/avatar_current.png">
    <link rel="stylesheet" href="/assets/style/main.css">
    <slot name="head" />
</head>
<body>

<header class="site-header">
    <div class="container header-inner">
        <div class="logo-area">
            <h1>NoTuring_Steve <span class="logo-suffix">in <a href="https://github.com/Team-Astralisium">Team Astralisium</a></span></h1>
            <p>一个随便写两下就跑起来的博客。。。</p>
        </div>
        <div class="nav-links">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
    </div>
</header>

<div class="container">
    <div class="content-grid">
        <main class="main-blog">
            <slot />
        </main>
        <slot name="aside" />
    </div>
</div>

<footer class="site-footer">
    <div class="container footer-inner">
        <div>Website © Copyright 2026 Team Astralisium, All Rights Reserved.</div>
        <div class="footer-links">
            <a href="https://creativecommons.org/licenses/by-sa/4.0/">内容许可：CC-BY-SA 4.0</a>
        </div>
    </div>
</footer>
</body>
</html>